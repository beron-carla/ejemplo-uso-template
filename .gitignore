# ---------------------------------------------------------
# .gitignore — Nexo Digital (sitio estático + PHP)
# ---------------------------------------------------------

# Sistema operativo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# Editores e IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace
*.swp
*.swo
*~

# Logs y archivos temporales
*.log
error_log
php_errors.log
*.tmp
tmp/
temp/

# Dependencias (solo en la raíz; assets/vendor se conserva)
/node_modules/
/bower_components/
/vendor/

# Entorno y secretos
.env
.env.*
!.env.example
*.local

# PHP y bases de datos locales
.phpunit.result.cache
*.sqlite
*.sqlite3
/uploads/
/cache/

# Builds y capturas de revisión
/dist/
/build/
/.qa/
/.shots/

# Copias de seguridad
*.bak
*.orig
